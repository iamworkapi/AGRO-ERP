{
  "buildCommand": "npm --prefix FrontEnd run build",
  "outputDirectory": "FrontEnd/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-nine-phi-92.vercel.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
