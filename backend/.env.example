# MongoDB connection string (Atlas or local). Never commit the real value -
# this file only holds placeholders. Your actual backend/.env is gitignored.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/agripr_erp

# Secret used to sign/verify JWT access tokens - use a long random string,
# different per environment.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

PORT=3000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (the Vite dev
# server origin by default).
CORS_ORIGIN=http://localhost:5173

# Used by scripts/createSuperAdmin.js and scripts/seedDefaultUsers.js.
# These match the "Quick Demo Login Roles" buttons on the frontend's Login
# page exactly - change one, change the other, or they'll drift apart.
# DEV/DEMO ONLY - change these before running against anything real.
SUPER_ADMIN_EMAIL=iamworkapi@gmail.com
SUPER_ADMIN_PASSWORD=admin12
SUPER_ADMIN_NAME=Super Admin

DEFAULT_ADMIN_NAME=Warehouse Admin
DEFAULT_ADMIN_EMAIL=admin@pralli.com
DEFAULT_ADMIN_PHONE=9999999998
DEFAULT_ADMIN_PASSWORD=admin@123

DEFAULT_SUPERVISOR_NAME=Supervisor
DEFAULT_SUPERVISOR_EMAIL=supervisor@pralli.com
DEFAULT_SUPERVISOR_PHONE=8888888888
DEFAULT_SUPERVISOR_PASSWORD=supervisor12

# Optional - powers "forgot password" OTP delivery (POST /auth/forgot-password).
# Without these, OTPs are just printed to the server console instead of
# actually emailed/texted, so the reset flow still works end to end in dev.
#
# SMTP: any provider works (Gmail app password, Mailtrap for local testing,
# SES/SendGrid SMTP relay, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AgriPrali ERP <no-reply@pralli.com>

# SMS: called directly via Twilio's REST API (no SDK dependency). Swap
# src/utils/sms.js for another provider if you're not using Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
